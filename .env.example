# Used as both the PostgreSQL database name and the scanner ID.
# Change this value to isolate another network in its own database.
BLOCKCHAIN_NETWORK_AND_DATABASE_NAME=ethereum-mainnet

# PostgreSQL server connection only; do not add a database name after the port.
# The application creates the database above if it does not exist.
DATABASE_URL=postgres://postgres:YOUR_PASSWORD@localhost:5432

# Set RPC URLs to endpoints for the same network named above.
RPC_URL_1=https://mainnet.infura.io/v3/YOUR_INFURA_PROJECT_ID
RPC_URL_2=https://YOUR_SECOND_PROVIDER_ENDPOINT
